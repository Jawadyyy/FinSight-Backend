# Copy this file to .env and fill in real values.

NODE_ENV=development
PORT=3000

# Postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=finsight

# JWT — the two secrets MUST be different, that is what stops a refresh token
# from being accepted as an access token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (frontend @react-oauth/google popup + backend verify).
# Create an OAuth client ID (Web application) at:
#   https://console.cloud.google.com  →  APIs & Services  →  Credentials
# Under "Authorised JavaScript origins" add your frontend origin:
#   http://localhost:5173
# Only the client id is needed here — the backend just verifies the ID token.
GOOGLE_CLIENT_ID=your-google-client-id
